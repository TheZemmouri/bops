{
  "verticals": {
    "window_tint_auto": {
      "name": "Automotive Window Tint",
      "description": "Window tinting films for automotive applications",
      "scoring": {
        "formula": {
          "quality": 0.40,
          "sentiment": 0.35,
          "value": 0.25
        },
        "quality_metrics": {
          "ir_rejection": { "weight": 0.28, "unit": "%", "higherIsBetter": true },
          "tser": { "weight": 0.22, "unit": "%", "higherIsBetter": true },
          "uv_protection": { "weight": 0.15, "unit": "%", "higherIsBetter": true },
          "optical_clarity": { "weight": 0.12, "unit": "subjective", "higherIsBetter": true },
          "install_handling": { "weight": 0.13, "unit": "subjective", "higherIsBetter": true },
          "color_stability": { "weight": 0.10, "unit": "subjective", "higherIsBetter": true }
        },
        "sentiment_sources": [
          "installer_reviews",
          "field_feedback",
          "warranty_claims",
          "social_mentions"
        ],
        "value_calculation": "performance_score / (msrp / 100)"
      },
      "product_attributes": [
        "vlt_shades",
        "manufacturer",
        "series_name",
        "msrp_per_sqft",
        "warranty_years",
        "construction_type",
        "dyed_metallic_ceramic"
      ]
    },
